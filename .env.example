# Copy this file to ".env" (same folder as index.js) and fill in YOUR values.
# Never commit the real .env file. It is already listed in .gitignore.

PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
# Must match the database where you ran the schema and add_announcements.sql
DB_NAME=study_cafe

# Any long random text. Used to sign login tokens (required for login to work).
JWT_SECRET=change_this_to_a_long_random_secret
